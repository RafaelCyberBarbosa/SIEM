# --- Database ---
# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./data/siem.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+psycopg2://siem:siem@localhost:5432/siem

# --- Security ---
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Global API key accepted from any ingestion source in addition to per-source keys
INGEST_API_KEY=change-this-ingest-key

# --- Bootstrap admin user (created on first run if no users exist) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_EMAIL=admin@example.com

# --- Syslog listener ---
SYSLOG_UDP_ENABLED=true
SYSLOG_UDP_PORT=5514
SYSLOG_TCP_ENABLED=true
SYSLOG_TCP_PORT=5514
SYSLOG_BIND_HOST=0.0.0.0

# --- Detection engine ---
DETECTION_INTERVAL_SECONDS=5

# --- Alerting: SMTP email (optional) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=siem-alerts@example.com
SMTP_TO=soc-team@example.com
SMTP_USE_TLS=true

# --- Alerting: generic webhook (Slack/Discord/Teams-compatible JSON) ---
WEBHOOK_ENABLED=false
WEBHOOK_URL=

# --- Data retention ---
EVENT_RETENTION_DAYS=90
